{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.5"}

         ;; VAPID signing and RFC 8291 payload encryption.
         nl.martijndwars/web-push {:mvn/version "5.1.1"}
         ;; NOT transitive, and not optional. web-push's PushService has
         ;; BouncyCastle types in its method signatures, so resolving
         ;; .setPublicKey fails at COMPILE time without these -- and at
         ;; RUNTIME the provider must also be registered, which
         ;; nickdex.grain.push.send does on load.
         org.bouncycastle/bcprov-jdk18on {:mvn/version "1.78.1"}
         org.bouncycastle/bcpkix-jdk18on {:mvn/version "1.78.1"}

         cheshire/cheshire {:mvn/version "5.13.0"}
         com.brunobonacci/mulog {:mvn/version "0.9.0"}

         ;; Subscriptions are rows. Versions match what
         ;; grain-event-store-sqlite-v3 already puts on a consuming app's
         ;; classpath, so this never forces a different driver into the
         ;; same process as the event store it shares a file with.
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
         org.xerial/sqlite-jdbc {:mvn/version "3.46.1.3"}
         com.cognitect/anomalies {:mvn/version "0.1.12"}}

 ;; No dependency on libs/auth. Push takes an opaque account id, so an
 ;; app can have notifications without passkeys -- and two :deps/root
 ;; entries from one repo that share a vendored component fail to resolve
 ;; with "no known ancestor relationship between local versions".

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}}}

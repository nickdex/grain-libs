-- allium: 3
-- auth.allium

-- Scope: passkey authentication for a Grain + Datastar application
--   (grain-libs/libs/auth/)
-- WebAuthn credentials, the sessions they open, and the management of
-- both. This is a library spec: it governs credentials and sessions and
-- knows nothing about the person behind them.
--
-- The consuming application supplies User. Nothing here reads a field
-- on it, so any entity with identity will do -- see identity.allium in
-- smriti for the first consumer.
--
-- Includes: registering a credential, signing in with one, signing out,
--           renaming and removing credentials, session expiry,
--           the enrolment code that puts the FIRST credential on an
--           user, and the operator reset that allows another
-- Excludes:
--   - The user itself: name, email, profile, and whether a user
--     may be created at all. The consumer owns registration, which is
--     what lets an application close signup without this spec knowing
--   - Every non-passkey way of SIGNING IN: password, emailed sign-in
--     code, magic link, OAuth. The enrolment code below is not one of
--     these -- it buys the right to register a first passkey and never
--     opens a session by itself
--   - How an enrolment code reaches the person. Read down a phone, put
--     in a message, printed: the medium is the consumer's, and the code
--     is designed to survive all of them
--   - Self-service recovery. Losing every credential is an operator
--     matter here (ResetCredentials), not something the person holding
--     the user can do alone
--   - The WebAuthn wire ceremony: challenge issue, attestation and
--     assertion verification, relying-party id and origin. Transport,
--     and the reason a vetted library does it rather than this spec
--   - Which credential opened a session. Recording it would tie a
--     session's lifetime to a credential's, and removing a credential
--     already ends every session on the user
--   - Datastar signals, SSE patching, routes

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- A type placeholder. The consuming spec substitutes its own user
-- entity; this one is never read, only held.
external entity User {}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract Authenticator {
    make_credential: (user: User, challenge: String) -> Credential
    sign: (challenge: String) -> Integer

    @invariant CounterRisesOrStaysZero
        -- A device-bound authenticator returns a signature counter
        -- strictly greater than the one it last returned. A synced
        -- authenticator returns 0 every time, because a counter cannot
        -- be kept consistent across copies that are all legitimate.

    @invariant PrivateKeyNeverLeaves
        -- Only the public key is ever handed over. Nothing in this spec
        -- can read or transport the private half, which is the whole
        -- reason a passkey is not a password.

    @guidance
        -- WebAuthn, as implemented by the browser and the platform or
        -- roaming authenticator behind it. Verification of what comes
        -- back is a solved and easy-to-get-wrong problem: use a vetted
        -- library rather than reading the CBOR by hand.
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Credential {
    user: User

    -- The authenticator's own identifier for this key. Unique across
    -- every user, not merely within one.
    credential_id: String

    -- The public half. The private half never leaves the authenticator.
    public_key: String

    -- The authenticator's signature counter as of the last assertion.
    -- 0 forever on a synced passkey; see Authenticator.
    sign_count: Integer

    -- What the person calls this key. Theirs to set: an authenticator
    -- does not reliably say what it is.
    label: String

    created_at: Timestamp
    last_used_at: Timestamp?
}

entity Session {
    user: User
    started_at: Timestamp
    last_seen_at: Timestamp
    expires_at: Timestamp

    status: active | signed_out | expired

    transitions status {
        active -> signed_out
        active -> expired
        terminal: signed_out, expired
    }
}

-- The grant that lets a brand-new user register its first passkey.
--
-- Registering a credential needs an authenticated caller and a new
-- user has nothing to authenticate with, so something has to bridge
-- that gap exactly once. A short code does it without a signing key and
-- without putting a bearer credential in a URL.
entity EnrolmentCode {
    user: User

    -- Only ever the hash. See CodeIsNeverStoredInTheClear.
    code_hash: String

    expires_at: Timestamp
    failed_attempts: Integer
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- How long a sign-in lasts before it has to be done again. Absolute,
    -- measured from the sign-in: a session that is used every day still
    -- ends on schedule.
    session_lifetime: Duration = 30.days

    -- How long an enrolment code is good for. Long enough to send it
    -- through a message and let somebody get to it; short enough that
    -- an intercepted message is stale before it is useful.
    enrolment_lifetime: Duration = 1.hour

    -- Wrong guesses before a code is dead. This, not the length of the
    -- code, is what makes a short one safe: six digits is a million
    -- values, and five tries is a 1-in-200,000 chance.
    enrolment_max_attempts: Integer = 5
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule RegisterCredential {
    when: RegisterCredential(user, credential_id, public_key, sign_count, label)

    requires: label != ""
    requires: not exists Credential{credential_id: credential_id}

    ensures:
        Credential.created(
            user: user,
            credential_id: credential_id,
            public_key: public_key,
            sign_count: sign_count,
            label: label,
            created_at: now,
        )

    @guidance
        -- The uniqueness check spans every user, not just this one.
        -- A credential_id is unique by construction, so a collision is
        -- not two people picking the same name -- it is the same key
        -- being claimed twice, and letting the second claim through
        -- would resolve one credential to two users.
        --
        -- Registration runs against a user that already exists. An
        -- application with open signup creates the user first and
        -- registers the credential second; one with closed signup
        -- simply never offers the first step. That is the whole
        -- difference, and it is the consumer's to make.
}

rule SignIn {
    when: PresentAssertion(credential, sign_count)

    requires: sign_count > credential.sign_count or sign_count = 0

    ensures:
        credential.sign_count = sign_count
        credential.last_used_at = now
        Session.created(
            user: credential.user,
            started_at: now,
            last_seen_at: now,
            expires_at: now + config.session_lifetime,
            status: active,
        )

    @guidance
        -- The counter check is WebAuthn's clone detection: a genuine
        -- device-bound authenticator's counter only rises, so one that
        -- repeats or goes backwards means the key was copied.
        --
        -- The zero case is not an exemption bolted on afterwards.
        -- Synced authenticators -- Apple's and Google's, which is most
        -- passkeys in use -- report 0 on every assertion by design.
        -- Requiring a rise would reject them all.
        --
        -- Which credential was presented is settled before this rule
        -- fires: the assertion names it, and verifying the signature
        -- against that credential's public key is what makes the naming
        -- trustworthy.
}

rule SignOut {
    when: SignOut(session)

    requires: session.status = active

    ensures: session.status = signed_out

    @guidance
        -- Serves both signing yourself out here and ending a session
        -- somewhere else. Nothing distinguishes them: a session is
        -- ended by whoever holds the user, and where the request came
        -- from does not change what happens to it.
}

rule SessionExpires {
    when: session: Session.expires_at <= now

    requires: session.status = active

    ensures: session.status = expired

    @guidance
        -- The status guard is what stops this re-firing: an expired
        -- session's expires_at stays in the past forever.
}

rule RenameCredential {
    when: RenameCredential(credential, label)

    requires: exists credential
    requires: label != ""

    ensures: credential.label = label
}

rule RemoveCredential {
    when: RemoveCredential(target)

    requires: exists target
    requires: (Credentials where user = target.user).count > 1

    ensures:
        for s in Sessions where user = target.user and status = active:
            s.status = signed_out
        not exists target

    @guidance
        -- Removing a key ends every session on the user, not only
        -- the ones that key opened. Blunt on purpose: a key is removed
        -- because it was lost or stolen, and at that moment the
        -- question is not which sessions it started but whether anyone
        -- else is still signed in.
        --
        -- The last credential cannot be removed. No password and no
        -- emailed sign-in means a user with no credentials is one
        -- nobody can reach, and a person can always register a
        -- replacement first and then remove this one.
        --
        -- Losing every key anyway is ResetCredentials, which is an
        -- operator's to run. Keeping that off this rule is deliberate:
        -- the refusal here should stay something a person can act on,
        -- not a door with a hidden handle.
}

rule IssueEnrolmentCode {
    when: IssueEnrolmentCode(user, code)

    requires: (Credentials where user = user).count = 0

    ensures:
        not exists EnrolmentCode{user: user}
        EnrolmentCode.created(
            user: user,
            code_hash: hash(code),
            expires_at: now + config.enrolment_lifetime,
            failed_attempts: 0,
        )

    @guidance
        -- Issuing replaces rather than adds, so a user has at most
        -- one live code and there is nothing to sweep when one goes
        -- unused. It also means reissuing is the answer to "I lost it",
        -- which matters because the plaintext is not recoverable.
        --
        -- Refused for a user that already has a key, so the
        -- operator hears about it at the moment of issue rather than
        -- the person hearing about it at the moment of use.
}

rule VerifyEnrolmentCode {
    when: VerifyEnrolmentCode(user, code)

    requires: c: exists EnrolmentCode{user: user}
    requires: c.failed_attempts < config.enrolment_max_attempts
    requires: c.expires_at > now
    requires: c.code_hash = hash(code)
    requires: (Credentials where user = user).count = 0

    ensures: not exists c

    @guidance
        -- The credential count is asked here as well as at issue. A code
        -- minted when a user had no key must not still work after
        -- one exists, or the window between the two is a window in which
        -- somebody else enrols.
        --
        -- Success consumes the code. What the caller is left holding is
        -- permission to register one passkey, and it has to be spent
        -- before the code could be answered a second time.
}

rule EnrolmentCodeGuessed {
    when: VerifyEnrolmentCode(user, code)

    requires: c: exists EnrolmentCode{user: user}
    requires: c.failed_attempts < config.enrolment_max_attempts
    requires: c.code_hash != hash(code) or c.expires_at <= now

    ensures: c.failed_attempts = c.failed_attempts + 1

    @guidance
        -- The counting is the defence. Six digits without it is a
        -- million tries against a fixed target, which is minutes of
        -- work; with it, a code is dead after five.
}

rule ResetCredentials {
    when: ResetCredentials(user)

    ensures:
        for c in Credentials where user = user:
            not exists c
        for s in Sessions where user = user and status = active:
            s.status = signed_out
        not exists EnrolmentCode{user: user}

    @guidance
        -- The way back from losing every device, and the reason
        -- RemoveCredential can go on refusing to take a last key.
        --
        -- Deliberately not on any surface. It turns a user somebody
        -- holds into a user whoever receives the next code holds,
        -- which is the one operation here that should cost a human
        -- decision rather than a request.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant CodeIsNeverStoredInTheClear {
    for c in EnrolmentCodes:
        c.code_hash != plaintext(c)
}

invariant AtMostOneLiveCodePerUser {
    for c in EnrolmentCodes:
        (EnrolmentCodes where user = c.user).count = 1
}

invariant EnrolmentCodeOnlyOnAnUnenrolledUser {
    for c in EnrolmentCodes:
        (Credentials where user = c.user).count = 0
}

invariant CredentialIdIsUnique {
    for c in Credentials:
        (Credentials where credential_id = c.credential_id).count = 1
}

invariant CredentialIsLabelled {
    for c in Credentials:
        c.label != ""
}

invariant ActiveSessionHasNotOutlivedItsGrant {
    for s in Sessions:
        s.status = active implies s.started_at <= s.expires_at
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor CredentialHolder {
    identified_by: Session where status = active
}

-- Whoever runs the system, reaching it out of band -- a REPL, a console
-- -- rather than through it. Deliberately NOT identified by a session:
-- an operator marker that a request could carry would be an operator
-- marker a request could forge.
actor Operator {
    identified_by: out_of_band
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface SignIn {
    provides:
        PresentAssertion(credential, sign_count)

    @guarantee ChallengeIsSingleUse
        -- Every assertion answers a challenge issued for that attempt
        -- and discarded with it. A captured assertion replayed later is
        -- refused, which is the only thing standing between an
        -- intercepted ceremony and the user behind it.

    @guarantee RejectionRevealsNothing
        -- A refused sign-in says the same thing whether the credential
        -- is unknown, belongs to someone else, or failed its counter
        -- check. Telling them apart turns this surface into a way to
        -- ask whether a user exists.

    @guidance
        -- No party is named here, because at this boundary there is not
        -- one yet. A discoverable credential identifies its own user:
        -- the person presents an assertion and the user follows from
        -- it, rather than naming themselves first and proving it after.
}

surface Enrolment {
    provides:
        VerifyEnrolmentCode(user, code)
        RegisterCredential(user, credential_id, public_key, sign_count, label)

    contracts:
        demands Authenticator

    @guarantee RejectionRevealsNothing
        -- One refusal for every failure: no such user, no code
        -- issued, the wrong code, an expired one, one guessed at too
        -- often, and a user already enrolled. Telling them apart
        -- says whether a user exists and whether it is already in
        -- use, to somebody holding nothing but a guess.

    @guarantee CodeIsSpentOnFirstSuccess
        -- Verification consumes the code. The permission it leaves
        -- behind covers registering one passkey, and both are gone
        -- afterwards -- so a code overheard once cannot be used twice,
        -- and cannot be used at all after the user has a key.

    @guidance
        -- No party is named, because at this boundary there is not one
        -- yet: the whole point is that the user has no credential to
        -- authenticate with. The user is named by its handle and the
        -- code is what makes the naming trustworthy.
        --
        -- Registering follows verification directly here rather than in
        -- CredentialManagement, because the person has no session. On
        -- success they should be signed in -- otherwise enrolment ends
        -- by asking somebody to prove possession of the key they made a
        -- second ago.
}

surface Operations {
    facing operator: Operator

    provides:
        IssueEnrolmentCode(user, code)
        ResetCredentials(user)

    @guarantee NotReachableOverHTTP
        -- Neither of these is mounted on a route, and neither is a
        -- command an application's request handler can dispatch. The
        -- guard is structural rather than a predicate somebody has to
        -- remember: there is no request that reaches them.

    @guidance
        -- Both are operator work by nature. Issuing a code is how a
        -- person is let in at all, and resetting credentials is the one
        -- operation that takes a user away from whoever currently
        -- holds it -- so both should cost a human decision.
        --
        -- An application with open signup would move IssueEnrolmentCode
        -- to a public surface and pair it with something that proves
        -- control of the handle. That is a different spec, and this one
        -- does not stop it.
}

surface SessionManagement {
    facing holder: CredentialHolder

    exposes:
        for s in Sessions where user = holder.user and status = active:
            s.started_at
            s.last_seen_at
            s.expires_at

    provides:
        SignOut(session)

    @guarantee SigningOutIsImmediate
        -- A session ended here stops working at once, on whatever
        -- device holds it. A sign-out that only takes effect when that
        -- device next asks is not a sign-out; it is a request.

    @guidance
        -- Every active session on the user, not only this one, so
        -- that "I signed in on a machine I no longer have" is something
        -- a person can act on themselves. The session being used to
        -- view this list is one of the entries and can be ended like any
        -- other.
}

surface CredentialManagement {
    facing holder: CredentialHolder

    exposes:
        for c in Credentials where user = holder.user:
            c.label
            c.created_at
            c.last_used_at

    provides:
        RegisterCredential(holder.user, credential_id, public_key, sign_count, label)
        RenameCredential(credential, label)
        RemoveCredential(credential)

    contracts:
        demands Authenticator

    @guarantee LastCredentialCannotBeRemoved
        -- Remove is not offered on the only remaining key, and is
        -- refused if asked for anyway. The refusal says why, because
        -- "add another key first" is a thing a person can act on and
        -- "not allowed" is not.

    @guarantee CredentialIdNeverShown
        -- What is shown is the label, when the key was added and when it
        -- was last used. The credential_id and public key are how the
        -- system recognises a key, not how a person does.

    @guidance
        -- Multiple credentials per user is the ordinary case, not an
        -- advanced one: a phone, a laptop and a hardware key is three,
        -- and a person with one is a person one lost device away from
        -- losing the user.
        --
        -- last_used_at is what makes a stale key recognisable. Without
        -- it, a list of keys is a list of names nobody can tell apart.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Is session_lifetime absolute or idle? Modelled as absolute -- expires_at is set once at sign-in and never moved, so a session in daily use still ends after 30 days. last_seen_at is recorded but nothing reads it. Idle expiry would extend expires_at on each request, which is friendlier and keeps a stolen session alive as long as it is being used."

open question "Should an enrolment code be reissuable while one is still live? Modelled as yes -- IssueEnrolmentCode replaces, and resets failed_attempts with it. That makes reissuing the answer to both 'I lost it' and 'I burnt the attempts', and it also means anyone who can ask for a code can clear an attacker's attempt count. The operator is the only caller today, so this is not reachable by a guesser."

open question "Should a failed sign-in be recorded? Nothing here observes one, so a credential can be probed without limit. Rate limiting is the usual answer and needs a fact to count."

open question "May one person hold sessions on several users at once? Session carries a single user and nothing forbids a second, but no surface exposes switching between them."

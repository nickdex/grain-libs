{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.5"}

         ;; WebAuthn verification. Attestation and assertion checking is a
         ;; solved and easy-to-get-wrong problem; auth.allium's
         ;; Authenticator contract says as much. Nothing here parses CBOR
         ;; by hand.
         com.yubico/webauthn-server-core {:mvn/version "2.7.0"}
         cheshire/cheshire {:mvn/version "5.13.0"}

         ;; Credentials and sessions are tables, not events. Versions are
         ;; pinned to what grain-event-store-sqlite-v3 already puts on a
         ;; consuming app's classpath, so this library never forces a
         ;; different JDBC driver into the same process as the event
         ;; store it shares a file with.
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
         org.xerial/sqlite-jdbc {:mvn/version "3.46.1.3"}

         ;; Rejections are anomaly maps, not exceptions. A consuming
         ;; Grain app already has this namespace via Grain's own
         ;; anomalies component; declared here so the library resolves
         ;; standalone, and the artifact is the same one Grain vendors.
         com.cognitect/anomalies {:mvn/version "0.1.12"}}

 ;; No Grain dependency. Auth is infrastructure, not a service area:
 ;; there are no commands, no events and no read models here, so nothing
 ;; in this library needs Grain's registries. That also means none of
 ;; these operations is reachable over Grain's command-request-handler,
 ;; which routes every registered command over HTTP -- the guard against
 ;; "POST a credential id, receive a session" is structural rather than
 ;; something each function has to remember.

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}}}
